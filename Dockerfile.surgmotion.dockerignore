# Build-context filter for Dockerfile.surgmotion only (BuildKit's
# <dockerfile>.dockerignore convention - does not affect the plain .dockerignore
# used by the existing v5 Dockerfile). Block everything by default, then
# explicitly allow-list only what the SurgMotion Grand Challenge entrypoint
# needs at inference time.
*

!src/
src/*.json
src/*.json.bak
src/__pycache__/

!checkpoints/
checkpoints/*
!checkpoints/base_models/
checkpoints/base_models/*
!checkpoints/base_models/Qwen2.5-VL-3B-Instruct/

!checkpoints/surgmotion_v2_stage_b_dev/
checkpoints/surgmotion_v2_stage_b_dev/checkpoint-*/
checkpoints/surgmotion_v2_stage_b_dev/trainer_state.json
checkpoints/surgmotion_v2_stage_b_dev/training_args.bin

!repo/
repo/*
!repo/SurgMotion-main/

!requirements.surgmotion.txt
!Dockerfile.surgmotion

.git/
