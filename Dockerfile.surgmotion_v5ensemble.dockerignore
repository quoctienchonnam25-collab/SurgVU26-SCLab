# Build-context filter for Dockerfile.surgmotion_v5ensemble only (BuildKit's
# <dockerfile>.dockerignore convention). Block everything by default, then
# explicitly allow-list only what the ensemble router needs at inference time.
*

!src/
src/*.json
src/*.json.bak
src/__pycache__/

!checkpoints/
checkpoints/*
!checkpoints/base_models/
checkpoints/base_models/*
!checkpoints/base_models/Qwen2.5-VL-3B-Instruct/

!checkpoints/surgmotion_v2_stage_b_dev/
checkpoints/surgmotion_v2_stage_b_dev/checkpoint-*/
checkpoints/surgmotion_v2_stage_b_dev/trainer_state.json
checkpoints/surgmotion_v2_stage_b_dev/training_args.bin

!checkpoints/qwen2_vl_2b_lora_v5/
checkpoints/qwen2_vl_2b_lora_v5/checkpoint-*/

!repo/
repo/*
!repo/SurgMotion-main/

!requirements.ensemble_v5.txt
!Dockerfile.surgmotion_v5ensemble

.git/
