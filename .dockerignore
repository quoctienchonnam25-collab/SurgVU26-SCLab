# detector/pretrain artifacts) then re-include just that one directory's
# root-level files (not its own intermediate checkpoint-N subdirs).
checkpoints/*
!checkpoints/qwen2_vl_2b_lora_v5/
checkpoints/qwen2_vl_2b_lora_v5/checkpoint-*/
checkpoints/qwen2_vl_2b_lora_v5/runs/

