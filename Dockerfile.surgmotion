FROM pytorch/pytorch:2.8.0-cuda12.6-cudnn9-runtime

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsm6 \
    libxext6 \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Grand Challenge rejects containers that run as root (see
# https://docs.docker.com/develop/develop-images/dockerfile_best-practices/#user) -
# create a dedicated non-root user, matching the official category-2 reference
# container's Dockerfile pattern.
RUN groupadd -r user && useradd -m --no-log-init -r -g user user

WORKDIR /app

# Install python dependencies (as root, into the base image's own conda env - only
# read access is needed from the non-root user at runtime).
COPY requirements.surgmotion.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code, the vendored SurgMotion encoder repo (frozen ViT-L weights +
# the python module predict_surgmotion_vqa.py imports as `src.models.vision_transformer`
# via sys.path insertion), the local Qwen2.5-VL-3B-Instruct base snapshot, and the
# single checkpoint predict_surgmotion_grand_challenge.py always uses (stage_b_dev -
# see that script's docstring for why there is no longer a second, organ-routed
# checkpoint). Unlike the v5 image, no from_pretrained() network fetch is needed at
# build time: this pipeline already loads the base model from a local directory
# with local_files_only=True.
COPY --chown=user:user src /app/src
COPY --chown=user:user repo/SurgMotion-main /app/repo/SurgMotion-main
COPY --chown=user:user checkpoints/base_models/Qwen2.5-VL-3B-Instruct /app/checkpoints/base_models/Qwen2.5-VL-3B-Instruct
COPY --chown=user:user checkpoints/surgmotion_v2_stage_b_dev /app/checkpoints/surgmotion_v2_stage_b_dev

ENV PYTHONPATH=/app

# The evaluation container runs with --network none - force offline mode so
# huggingface_hub/transformers never attempt a network call at runtime.
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

# SurgMotionVQA.generate() (surgmotion_vqa_prototype.py) runs a manual
# token-by-token loop with use_cache=False - every step reprocesses the whole
# (growing) sequence from scratch instead of reusing a KV-cache, so a single
# answer does ~24-32 variable-length alloc/free cycles. On a GPU with less headroom
# than this dev box, that fragmentation pattern is what previously produced
# "CUDA out of memory ... reserved but unallocated memory is large" during a real
# submission even though total usage stays well under capacity (measured peak here:
# ~8.3GB). This is the fix PyTorch's own error message recommends for exactly this
# pattern.
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

USER user

# Grand Challenge mounts /input and expects outputs in /output, invoking the
# container once per test case (see repo/surgvu2025-category2-submission). Which
# checkpoint to load is decided at runtime by the router in
# predict_surgmotion_grand_challenge.py, not a fixed CLI argument here.
ENTRYPOINT ["python", "src/predict_surgmotion_grand_challenge.py", "--input-dir", "/input", "--output-dir", "/output"]
