FROM pytorch/pytorch:2.8.0-cuda12.6-cudnn9-runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsm6 libxext6 git build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd -r user && useradd -m --no-log-init -r -g user user

WORKDIR /app
COPY submission/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Exactly the code and weights needed by DualEncoderVQA inference. The paired
# Dockerfile.dockerignore excludes datasets, frame caches and Trainer state.
COPY --chown=user:user src /app/src
COPY --chown=user:user repo/SurgMotion-main/src /app/repo/SurgMotion-main/src
COPY --chown=user:user repo/SurgMotion-main/ckpts/SurgMotion-vitl.pt /app/repo/SurgMotion-main/ckpts/SurgMotion-vitl.pt
COPY --chown=user:user checkpoints/base_models/Qwen2.5-VL-3B-Instruct /app/checkpoints/base_models/Qwen2.5-VL-3B-Instruct
COPY --chown=user:user checkpoints/dual_encoder_v3_stage_b_all155_combo /app/checkpoints/dual_encoder_v3_stage_b_all155_combo
COPY --chown=user:user submission/inference_policy_combo.json /app/submission/inference_policy.json

ENV PYTHONPATH=/app
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

USER user

ENTRYPOINT ["python", "src/predict_dual_encoder_vqa.py", "--checkpoint", "/app/checkpoints/dual_encoder_v3_stage_b_all155_combo", "--qwen-model", "/app/checkpoints/base_models/Qwen2.5-VL-3B-Instruct", "--surgmotion-checkpoint", "/app/repo/SurgMotion-main/ckpts/SurgMotion-vitl.pt", "--grand-challenge", "--input-dir", "/input", "--output-dir", "/output", "--tool-presence-threshold", "0.1", "--tissue-cutting-threshold", "-1.7", "--suture-required-threshold", "0.6"]
